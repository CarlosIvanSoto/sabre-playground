# Copiar a .env.local (ignorado por git) y llenar solo lo que se vaya a usar.
# Lo que falte queda deshabilitado: la app arranca igual, también sin .env.local.
# Nunca subir valores reales al repo.

# ── CERT (entorno por defecto) ──────────────────────────────────────────────
# PCC: campo reservado del SDK (opcional).
SABRE_CERT_PCC=

# REST (Sabre). AUTH_VERSION: v3 (por defecto) o v2.
# v3 pide CLIENT_ID, CLIENT_SECRET, USERNAME y PASSWORD; v2, solo USERNAME y PASSWORD (EPR).
SABRE_CERT_REST_AUTH_VERSION=
SABRE_CERT_REST_CLIENT_ID=
SABRE_CERT_REST_CLIENT_SECRET=
SABRE_CERT_REST_USERNAME=
SABRE_CERT_REST_PASSWORD=

# SOAP (SabreLegacy: sesión y colas).
# USERNAME con el formato V1:<user>:<PCC>:<domain> o <user>-<PCC>-<domain>.
# CLIENT_ID y CLIENT_SECRET van juntos (SessionCreateRQ 2.0.0) o ninguno (1.0.0).
SABRE_CERT_SOAP_USERNAME=
SABRE_CERT_SOAP_PASSWORD=
SABRE_CERT_SOAP_CLIENT_ID=
SABRE_CERT_SOAP_CLIENT_SECRET=

# ── Producción (opcional, siempre en solo lectura) ──────────────────────────
# Sin SABRE_PROD_ENABLED=true, producción no aparece aunque haya credenciales.
SABRE_PROD_ENABLED=
SABRE_PROD_PCC=

SABRE_PROD_REST_AUTH_VERSION=
SABRE_PROD_REST_CLIENT_ID=
SABRE_PROD_REST_CLIENT_SECRET=
SABRE_PROD_REST_USERNAME=
SABRE_PROD_REST_PASSWORD=

SABRE_PROD_SOAP_USERNAME=
SABRE_PROD_SOAP_PASSWORD=
SABRE_PROD_SOAP_CLIENT_ID=
SABRE_PROD_SOAP_CLIENT_SECRET=
